/*
 * Central (esquerda): recebe o trackpad da direita via zmk,input-split
 * e envia-o ao computador.
 */

#include <input/processors.dtsi>
#include "tps65_split.dtsi"

/ {
    tps65_listener: tps65_listener {
        compatible = "zmk,input-listener";
        device = <&tps65_split>;
        /*
         * Ao usar o trackpad, a layer 3 (Mouse) fica ativa durante 700 ms.
         * Velocidade: p.ex. <&zip_xy_scaler 3 2>, <&zip_temp_layer 3 700>;
         */
        input-processors = <&zip_temp_layer 3 700>;
    };
};
