config CORNE_TPS65_SCREEN
    bool "Ecrãs OLED personalizados (Corne + TPS65)"
    depends on ZMK_DISPLAY && ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    default y
    select LV_USE_IMAGE
    select LV_USE_LABEL
    select LV_FONT_UNSCII_8
    select LV_FONT_MONTSERRAT_16
    imply LV_USE_THEME_MONO
    imply ZMK_WPM if ZMK_SPLIT_ROLE_CENTRAL

if CORNE_TPS65_SCREEN

config LV_Z_MEM_POOL_SIZE
    default 8192

endif

config CORNE_TPS65_BOOT_POWER_CYCLE
    bool "Power-cycle VCC peripherals at boot (clean reset of trackpad/trackball/OLED)"
    default y
    depends on ZMK_EXT_POWER

config CORNE_TPS65_BOOT_POWER_OFF_MS
    int "VCC off time at boot (ms)"
    default 300
    depends on CORNE_TPS65_BOOT_POWER_CYCLE

config CORNE_TPS65_BOOT_POWER_SETTLE_MS
    int "Settle time after VCC on (ms)"
    default 50
    depends on CORNE_TPS65_BOOT_POWER_CYCLE
