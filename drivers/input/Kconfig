config INPUT_TPS43
    bool "Azoteq TPS43 I2C Touchpad Input Device"
    default y
    depends on I2C
    depends on INPUT
    help
      Enable driver for Azoteq touchpad input device over I2C interface.
      Supports multitouch gestures, scrolling, clicks and power management.

if INPUT_TPS43

config INPUT_TPS43_INIT_PRIORITY
    int "Init priority"
    default 90
    help
      Device driver initialization priority.

config INPUT_TPS43_INIT_RETRIES
    int "Init retries if the trackpad does not answer at boot"
    default 15

config INPUT_TPS43_INIT_RETRY_MS
    int "Delay between init retries (ms)"
    default 2000

config INPUT_TPS43_RDY_POLL
    bool "Poll the RDY pin as a fallback / debug aid"
    help
      Every INPUT_TPS43_RDY_POLL_MS, read the RDY pin level. Logs every level
      change (INF) and schedules a read if RDY is high, so a missed edge can
      never stall the trackpad. Useful to check whether the MCU actually sees
      the RDY signal.

config INPUT_TPS43_RDY_POLL_MS
    int "RDY poll period (ms)"
    default 100
    depends on INPUT_TPS43_RDY_POLL

endif # ZMK_SENSOR_TPS43

config INPUT_PIM447
    bool "Pimoroni PIM447 trackball"
    default y
    depends on DT_HAS_PIMORONI_PIM447_ENABLED
    depends on INPUT
    select I2C
    help
      Pimoroni Trackball Breakout (PIM447) over I2C.

config INPUT_PIM447_INIT_PRIORITY
    int "PIM447 init priority"
    default 91
    depends on INPUT_PIM447

config PIM447_LED_STRIP
    bool "PIM447 LED as extra pixel of the underglow strip"
    default y
    depends on DT_HAS_PIMORONI_PIM447_LED_STRIP_ENABLED && INPUT_PIM447 && LED_STRIP

config PIM447_LED_STRIP_INIT_PRIORITY
    int "PIM447 LED strip init priority"
    default 92
    depends on PIM447_LED_STRIP
